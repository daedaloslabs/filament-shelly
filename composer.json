{
    "name": "daedaloslabs/filament-shelly",
    "description": "Show live Shelly Cloud sensor stats (temperature, humidity, power, door/window, custom) on any Filament page.",
    "keywords": ["filament", "filament-plugin", "laravel", "shelly", "iot", "sensors", "widgets"],
    "homepage": "https://github.com/daedaloslabs/filament-shelly",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Mavroforakis",
            "email": "mavroforakis.m@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DaedalosLabs\\FilamentShelly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DaedalosLabs\\FilamentShelly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DaedalosLabs\\FilamentShelly\\ShellyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
